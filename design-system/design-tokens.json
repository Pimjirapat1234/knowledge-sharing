      "danger-dark": { "$value": "#D63031" },
      "danger-subtle": { "$value": "#FDECEC" },

      "warning": { "$value": "#FF9F43", "$description": "เตือน, ระวัง, ต้องตรวจสอบ" },
      "warning-light": { "$value": "#FFF0E1" },
      "warning-dark": { "$value": "#E08A30" },
      "warning-subtle": { "$value": "#FFF4E6" },

      "info": { "$value": "#00CFE8", "$description": "ข้อมูล, คำแนะนำ, tooltip" },
      "info-light": { "$value": "#D6F5FA" },
      "info-dark": { "$value": "#00A8C5" },
      "info-subtle": { "$value": "#E0F7FA" }
