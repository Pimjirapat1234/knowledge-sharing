      },
      "primary-light": { "$value": "#FF7A4D" },
      "primary-dark": { "$value": "#D14A1E" },
      "primary-hover": { "$value": "#E04E1F" },
      "primary-active": { "$value": "#C44419" },
      "primary-subtle": { "$value": "#FFF0EB" },
      "primary-muted": { "$value": "#FDDDD2" },
      "secondary": {
        "$value": "#231F20",
        "$description": "Raisin Black — Pantone 296 C | RGB(35,31,32)"
      },
      "secondary-light": { "$value": "#3A3536" },
      "secondary-hover": { "$value": "#1A1718" }
    },

    "semantic": {
      "success": { "$value": "#28C76F", "$description": "สำเร็จ, ยืนยัน, ผ่าน" },
      "success-light": { "$value": "#DFF7E9" },
      "success-dark": { "$value": "#1F9D57" },
      "success-subtle": { "$value": "#E8F8EE" },

