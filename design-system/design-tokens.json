    "status": {
      "pending": { "$value": "#FF9F43", "$description": "รอดำเนินการ" },
      "approved": { "$value": "#28C76F", "$description": "อนุมัติแล้ว" },
      "rejected": { "$value": "#EA5455", "$description": "ปฏิเสธ" },
      "draft": { "$value": "#ADB5BD", "$description": "แบบร่าง" },
      "review": { "$value": "#00CFE8", "$description": "กำลังตรวจสอบ" },
      "escalated": { "$value": "#7367F0", "$description": "ส่งต่อลำดับถัดไป" },
      "cancelled": { "$value": "#82868B", "$description": "ยกเลิก" }
    },

    "role": {
      "m3": { "$value": "#6366F1", "$description": "Approver M3" },
      "e1": { "$value": "#8B5CF6", "$description": "Approver E1" },
      "e2": { "$value": "#A855F7", "$description": "Approver E2" },
      "e3": { "$value": "#D946EF", "$description": "Approver E3" },
      "ceo": { "$value": "#F05A28", "$description": "CEO" },
      "accounting": { "$value": "#0EA5E9", "$description": "Accounting" },
      "cfo": { "$value": "#14B8A6", "$description": "CFO" },
      "procurement": { "$value": "#F59E0B", "$description": "Procurement" }
    },

    "department": {
      "hr": { "$value": "#EC4899" },
      "procurement": { "$value": "#F59E0B" },
      "operation": { "$value": "#10B981" },
